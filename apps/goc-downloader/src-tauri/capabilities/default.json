{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Game of Creators Downloader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$APPDATA/com.gameofcreators.downloader/**" },
        { "path": "$APPDATA/goc-downloader/**" }
      ]
    },
    "opener:default",
    "process:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/yt-dlp", "sidecar": true },
        { "name": "binaries/ffmpeg", "sidecar": true },
        { "name": "binaries/ffprobe", "sidecar": true },
        { "name": "binaries/deno", "sidecar": true }
      ]
    },
    "shell:allow-execute",
    "deep-link:default",
    "updater:default"
  ]
}
